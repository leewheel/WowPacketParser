<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../default.props" />

    <PropertyGroup>
        <!-- 加载器按 WowPacketParserModule.{VersionDefiningBuild}.dll 规则查找模块，
             因此程序集名必须是 V3_8_0_69137（与 ClientVersionBuild 枚举名一致），
             目录名保留用户约定的 V3_8_0_2_69137（对应显示版本 3.80.2.69137）。 -->
        <AssemblyName>WowPacketParserModule.V3_8_0_69137</AssemblyName>
        <OutputPath>../WowPacketParser/bin/$(Configuration)/Parsers/</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- 引用 V5_5_0 模块：3.80.2 专有 handler 可复用/调用其基线实现 -->
        <ProjectReference Include="..\WowPacketParserModule.V5_5_0_61735\WowPacketParserModule.V5_5_0_61735.csproj" />
    </ItemGroup>
</Project>
